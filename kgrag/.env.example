# ---- 运行环境配置（复制为 .env 后按需修改）----
# LLM（OpenAI 兼容接口）
KGRAG_LLM_BASE_URL=https://api.epicllmrouter.top/v1
KGRAG_LLM_API_KEY=sk-your-key-here
KGRAG_LLM_MODEL=deepseek-v4-pro-0813
KGRAG_LLM_MAX_TOKENS=8192

# RAG 索引目录（相对本工程根，或绝对路径）
KGRAG_INDEX=../rag_index

# 服务
KGRAG_HOST=0.0.0.0
KGRAG_PORT=8600
KGRAG_LOG_LEVEL=INFO

# 服务端访问密钥（留空表示本机内网免鉴权；对外暴露务必设置）
KGRAG_API_KEY=

# 检索默认参数
KGRAG_TOPK=8
KGRAG_WINDOW=1
